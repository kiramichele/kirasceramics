# .env.example
# Copy this to .env for local dev (netlify dev reads it automatically).
# In production, set these in: Netlify Dashboard → Site Settings → Environment Variables

# ── Stripe ───────────────────────────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...   # from Stripe CLI or webhook dashboard

# ── Firebase (Admin SDK — server-side only) ──────────────────────────
# Create a service account: Firebase Console → Project Settings → Service Accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Firebase (Client SDK — public, used in index.html) ───────────────
# These go in index.html directly (they're meant to be public).
# Firebase Console → Project Settings → Your Apps → Web App Config
# FIREBASE_API_KEY=AIza...
# FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# FIREBASE_MESSAGING_SENDER_ID=123456789
# FIREBASE_APP_ID=1:123456789:web:abc123
