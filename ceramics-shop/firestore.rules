// firestore.rules
// Deploy with: firebase deploy --only firestore:rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Products — anyone can read active products; only server (Admin SDK) can write
    match /products/{productId} {
      allow read: if resource.data.active == true;
      allow write: if false;   // writes come from Admin SDK (seed script / admin panel)
    }

    // Orders — no client reads/writes; only Admin SDK (webhook) writes
    match /orders/{orderId} {
      allow read, write: if false;
    }

  }
}
